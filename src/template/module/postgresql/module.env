KIND=database
ENGINE=postgres
MODES=cluster managed
MANAGED=true
IMAGE=postgres:18.6-alpine
ENGINE_VERSION=18.6
PORT=5432
USER=70
ROOT_USER=infrax
SIZE=20Gi
CPU=250m
MEMORY=512Mi
MEMORY_LIMIT=2Gi
SSLMODE_CLUSTER=disable
SSLMODE_MANAGED=require
EXTENSIONS=
DUMP=dump
EXPORTER=prometheus-postgres-exporter
URL=postgresql://${BIND_USER}:${BIND_PASSWORD_URI}@${BIND_HOST}:${BIND_PORT}/${BIND_DATABASE}?sslmode=${BIND_SSLMODE}
