KIND=database
ENGINE=mysql
MODES=cluster managed
MANAGED=true
IMAGE=mysql:8.4.11
ENGINE_VERSION=8.4.11
PORT=3306
USER=999
ROOT_USER=infrax
SIZE=20Gi
CPU=250m
MEMORY=768Mi
MEMORY_LIMIT=2Gi
SSLMODE_CLUSTER=
SSLMODE_MANAGED=
DUMP=sql
EXPORTER=prometheus-mysql-exporter
URL=mysql://${BIND_USER}:${BIND_PASSWORD_URI}@${BIND_HOST}:${BIND_PORT}/${BIND_DATABASE}
