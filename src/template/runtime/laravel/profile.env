PORT=8000
HEALTH=/up
PROBE=http
USER=33
BIND=laravel
MOUNT=/app/storage/app
MIGRATE=php artisan migrate --force
SECRETS=APP_KEY

PROCESSES=web
WEB_COMMAND=
WEB_CPU=250m
WEB_MEMORY=512Mi
WEB_MEMORY_LIMIT=1Gi
HORIZON_COMMAND=php artisan horizon
HORIZON_CPU=100m
HORIZON_MEMORY=384Mi
HORIZON_MEMORY_LIMIT=1536Mi
HORIZON_GRACE=90
QUEUE_COMMAND=php artisan queue:work --sleep=1 --tries=3 --max-time=3600
QUEUE_CPU=100m
QUEUE_MEMORY=256Mi
QUEUE_MEMORY_LIMIT=768Mi
QUEUE_GRACE=60
SCHEDULER_COMMAND=php artisan schedule:work
SCHEDULER_CPU=50m
SCHEDULER_MEMORY=128Mi
SCHEDULER_MEMORY_LIMIT=512Mi
REVERB_COMMAND=php artisan reverb:start --host=0.0.0.0 --port=$(PORT)
REVERB_PORT=8080
REVERB_ROUTE=/app
REVERB_CPU=100m
REVERB_MEMORY=256Mi
REVERB_MEMORY_LIMIT=768Mi

BUILD_ARGS=BUILD_IMAGE COMPOSER_IMAGE PHP_EXT_VERSION
BUILD_IMAGE=dunglas/frankenphp:1.12.7-php8.5-trixie
COMPOSER_IMAGE=composer:2.10.3
PHP_EXT_VERSION=2.11.12
PROVE_ENV=APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= APP_ENV=production LOG_CHANNEL=stderr DB_CONNECTION=sqlite DB_DATABASE=:memory: CACHE_STORE=array SESSION_DRIVER=array QUEUE_CONNECTION=sync
