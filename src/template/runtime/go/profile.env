PORT=8080
HEALTH=/health
PROBE=http
USER=65532
BIND=url
MOUNT=/data
MIGRATE=

PROCESSES=web
WEB_COMMAND=
WEB_CPU=50m
WEB_MEMORY=64Mi
WEB_MEMORY_LIMIT=256Mi
WORKER_CPU=50m
WORKER_MEMORY=64Mi
WORKER_MEMORY_LIMIT=256Mi

BUILD_ARGS=BUILD_IMAGE BASE_IMAGE MAIN
BUILD_IMAGE=golang:1.27.1-trixie
BASE_IMAGE=gcr.io/distroless/static-debian13:nonroot
MAIN=.
PROVE_ENV=
